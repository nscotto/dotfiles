# Define completion directory (with XDG fallback)
: ${ZCOMP:=${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions}

# Create completion directory if needed
if [[ ! -d "$ZCOMP" ]]; then
  mkdir -p "$ZCOMP" || {
    echo "Failed to create completion directory: $ZCOMP" >&2
    return 1
  }
fi

# Docker completion (prefer native generation)
if [[ ! -f "$ZCOMP/_docker" ]]; then
  if command -v docker &>/dev/null; then
    echo "Generating Docker completions..."
    mkdir -p "$ZCOMP/_docker.tmp"
    if docker completion zsh > "$ZCOMP/_docker.tmp/_docker" 2>/dev/null; then
      mv "$ZCOMP/_docker.tmp/_docker" "$ZCOMP/_docker"
      rmdir "$ZCOMP/_docker.tmp"
    else
      echo "Failed to generate Docker completions, will try download..." >&2
      rm -rf "$ZCOMP/_docker.tmp"
      # Fall through to download method
    fi
  else
    echo "Docker not installed - completions won't be available" >&2
    echo "Install Docker first: https://docs.docker.com/get-docker/" >&2
  fi
fi

# Add completion directory to fpath if it exists and isn't already there
[[ -d "$ZCOMP" && ! ${fpath[(Ie)$ZCOMP]} ]] && fpath=("$ZCOMP" $fpath)

## menu-style
zstyle ':completion:*' menu select
autoload -Uz compinit && compinit -i
zstyle ':completion:*' special-dirs true
# case insensitive
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
# Tab completion colors
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
# add new installed packages into completions
zstyle ':completion:*' rehash true
# Use better completion for the kill command
#zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;34'
#zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'
# use completion cache
zstyle ':completion::complete:*' use-cache true
# for docker
zstyle ':completion:*:*:docker:*' option-stacking yes
zstyle ':completion:*:*:docker-*:*' option-stacking yes

# [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
# 
# # To customize prompt, run `p10k configure` or edit ~/.config/zsh/.p10k.zsh.
# [[ ! -f ~/.config/zsh/.p10k.zsh ]] || source ~/.config/zsh/.p10k.zsh

################################################################################
#                                                                              #
# Plugins                                                                      #
#                                                                              #
################################################################################
#auto suggestions
autosugestions_dir="$ZPLUG/zsh-autosuggestions" 
autosugestions="$autosugestions_dir/zsh-autosuggestions.zsh" 
[ ! -f "$autosugestions" ] && \
  git clone https://github.com/zsh-users/zsh-autosuggestions.git "$autosugestions_dir"
source "$autosugestions"
set ZSH_AUTOSUGGEST_USE_ASYNC=true
#fast syntax highlighting
syntax_dir="$ZPLUG/fast-syntax-highlighting"
syntax="$syntax_dir/fast-syntax-highlighting.plugin.zsh"
[ ! -f "$syntax" ] && \
  git clone https://github.com/zdharma-continuum/fast-syntax-highlighting.git "$syntax_dir"
source "$syntax"
# z command
zcmd_dir="$ZPLUG/zsh-z"
zcmd="$zcmd_dir/zsh-z.plugin.zsh"
[ ! -f "$zcmd" ] && \
  git clone https://github.com/agkozak/zsh-z.git "$zcmd_dir"
source "$zcmd"

# ===== FZF Auto-Setup =====
export FZF_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fzf"
export FZF_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fzf-zsh-plugin"

# 1. Install FZF if missing
if ! command -v fzf &>/dev/null; then
  if [[ ! -d "$FZF_DIR" ]]; then
    echo "Installing fzf..."
    git clone --depth 1 https://github.com/junegunn/fzf.git "$FZF_DIR"
    "$FZF_DIR/install" --bin --no-update-rc --no-bash --no-fish
  fi
  path=("$FZF_DIR/bin" $path)
fi

# 2. Ensure .fzf/shell exists with key files
if [[ ! -f ~/.fzf/shell/key-bindings.zsh ]]; then
  mkdir -p ~/.fzf/shell

  # Try copying from system locations first
  local system_files=(
    "/usr/share/doc/fzf/examples/key-bindings.zsh"
    "/usr/share/doc/fzf/examples/completion.zsh"
  )

  for file in $system_files; do
    if [[ -f $file ]]; then
      cp "$file" ~/.fzf/shell/
    elif [[ -d "$FZF_DIR" ]]; then
      # Fallback to local install files
      cp "$FZF_DIR/shell/${file:t}" ~/.fzf/shell/ 2>/dev/null || :
    fi
  done
fi

# 3. Source FZF core files
[[ -f ~/.fzf/shell/key-bindings.zsh ]] && source ~/.fzf/shell/key-bindings.zsh
[[ -f ~/.fzf/shell/completion.zsh ]] && source ~/.fzf/shell/completion.zsh

# 4. Install and source fzf-zsh-plugin if wanted
if [[ ! -d "$FZF_PLUGIN_DIR" ]]; then
  echo "Installing fzf-zsh-plugin..."
  git clone --depth 1 https://github.com/unixorn/fzf-zsh-plugin.git "$FZF_PLUGIN_DIR"
fi

[[ -f "$FZF_PLUGIN_DIR/fzf-zsh-plugin.plugin.zsh" ]] && \
  source "$FZF_PLUGIN_DIR/fzf-zsh-plugin.plugin.zsh"

# Clean up PATH
typeset -U path
